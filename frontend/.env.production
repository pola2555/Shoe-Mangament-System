# Production build (npm run build) — the SPA is hosted on S3, a DIFFERENT origin from
# the API, so it must call the API by absolute URL. Without this the app falls back to a
# relative "/api", which on S3 resolves to the S3 bucket itself and returns 405 on POST.
#
# This is the droplet's nginx (port 80) in front of the Node API. When a domain + TLS are
# added later, change this to https://api.yourdomain.com/api and rebuild.
VITE_API_URL=http://46.101.236.229/api
