# Base URL for the backend API.
#
# Leave unset (or use the relative default) when the SPA is served from the same origin
# as the API behind nginx — that keeps the app protocol-agnostic and lets TLS terminate
# at the proxy without a rebuild.
#
# Set an absolute URL only when the frontend is served from a different origin.
# Always prefer https:// — the previous hardcoded http:// endpoint sent JWTs in cleartext.
VITE_API_URL=/api
